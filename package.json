{
  "name": "fastbrowse",
  "version": "1.0.0",
  "description": "A lightweight Chromium browser that automatically summarizes visited web pages.",
  "main": "main.js",
  "scripts": {
    "dev:vite": "vite",
    "dev:electron": "electron .",
    "dev": "concurrently \"npm run dev:vite\" \"wait-on tcp:5173 && npm run dev:electron\"",
    "build": "vite build && electron-builder"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "@xenova/transformers": "^2.17.2",
    "jsdom": "^29.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "vite": "^5.2.0",
    "wait-on": "^7.2.0"
  }
}
